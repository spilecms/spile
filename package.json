{
	"name": "spile",
	"version": "0.1.2",
	"private": true,
	"scripts": {
		"start": "pnpm build && go run ./api/main.go",
		"dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"pnpm dev:web\" \"pnpm dev:api\"",
		"dev:web": "pnpm --filter web dev",
		"dev:api": "go run ./api/main.go",
		"build": "pnpm build:web && pnpm build:api",
		"build:web": "pnpm --filter web build",
		"build:sdk": "pnpm --filter @spilecms/sdk build",
		"build:api": "echo Building Go API (bin/spile.exe)... && go build -o bin/spile.exe ./api/main.go && echo Go API binary built successfully : bin/spile.exe",
		"check": "pnpm --filter web check && pnpm --filter @spilecms/sdk check && go vet ./api/...",
		"check:write": "pnpm --filter web check:write && pnpm --filter @spilecms/sdk check:write",
		"test": "pnpm test:api && pnpm test:sdk",
		"test:api": "go test ./api/...",
		"test:sdk": "pnpm --filter @spilecms/sdk test",
		"test:all": "pnpm test:api && pnpm test:sdk && pnpm check",
		"setup": "pnpm --filter web install && go mod tidy",
		"prepare": "simple-git-hooks",
		"changeset": "changeset",
		"version:packages": "changeset version",
		"release:sdk": "changeset publish"
	},
	"simple-git-hooks": {
		"commit-msg": "pnpm commitlint --edit \"$1\""
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"concurrently": "^10.0.6",
		"simple-git-hooks": "^2.14.0"
	}
}
