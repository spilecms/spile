# ==============================================================================
# Spile CMS — Server Environment Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Server HTTP Port
PORT=8080

# SQLite Database File Path
DATABASE_PATH=spile.db

# Session & Token Signing Secret (MUST be changed in production!)
# In production mode (APP_ENV=production), the server will refuse to start if left as default.
# Generate a strong 64-character secret, e.g.: openssl rand -base64 48
SESSION_SECRET=spile-default-dev-secret-key-change-me

# CORS Allowed Origins (comma-separated list of origins permitted to call the API with credentials)
# Example: http://localhost:5173,http://localhost:8080,https://my-site.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Maximum Media Upload Size in Megabytes (default: 50)
MAX_UPLOAD_SIZE_MB=50

# Local Media Uploads Directory (default: ./uploads, in Docker: /data/uploads)
UPLOADS_PATH=./uploads
